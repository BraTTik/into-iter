{
  "name": "into-iter",
  "version": "0.1.0",
  "description": "Lazy chainable adapters for iterables",
  "license": "MIT",
  "author": "brattik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BraTTik/into-iter.git"
  },
  "bugs": {
    "url": "https://github.com/BraTTik/into-iter/issues"
  },
  "homepage": "https://github.com/BraTTik/into-iter#readme",
  "type": "module",
  "sideEffects": [
    "./dist/map.js",
    "./dist/enumerate.js",
    "./dist/filter.js",
    "./dist/limit.js",
    "./dist/skip.js",
    "./dist/flat-map.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js",
      "default": "./dist/map.js"
    },
    "./enumerate": {
      "types": "./dist/enumerate.d.ts",
      "import": "./dist/enumerate.js",
      "default": "./dist/enumerate.js"
    },
    "./filter": {
      "types": "./dist/filter.d.ts",
      "import": "./dist/filter.js",
      "default": "./dist/filter.js"
    },
    "./limit": {
      "types": "./dist/limit.d.ts",
      "import": "./dist/limit.js",
      "default": "./dist/limit.js"
    },
    "./skip": {
      "types": "./dist/skip.d.ts",
      "import": "./dist/skip.js",
      "default": "./dist/skip.js"
    },
    "./flat-map": {
      "types": "./dist/flat-map.d.ts",
      "import": "./dist/flat-map.js",
      "default": "./dist/flat-map.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "dev": "tsx --watch examples/playground.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "types": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "resolutions": {
    "@yarnpkg/core": "4.9.1"
  }
}
