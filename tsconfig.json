{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {"@/*": ["./src/*"]},
    "rootDir": "./src",
    "outDir": "dist/",
    "lib": ["ESNext", "ES2025.Iterator"]
  },
  "include": ["./src"]
}
